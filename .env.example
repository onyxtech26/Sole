# Optional Vite build-time overrides. The app ships with working public
# defaults in src/lib/config.ts (URL + anon key are safe to expose — access is
# governed by Supabase RLS + the signed-in user's JWT), so these are NOT required
# for the app to build or run. Set them only to point a build at a different project.
VITE_SUPABASE_URL=https://jpsyrostafidkneqflui.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# NEVER commit the service_role / secret key. Seeding + smoke scripts read it from
# environment variables at run time only:
#   SUPABASE_SERVICE_KEY=...   (scripts/seed.ts)
#   SUPABASE_ANON_KEY=...       (scripts/smoke.ts)
